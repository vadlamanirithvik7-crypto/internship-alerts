# --- Database ---------------------------------------------------------------
# Local dev default is SQLite; set this to your Supabase pooled connection string
# for production (Supabase dashboard > Project Settings > Database > Connection string > URI).
DATABASE_URL=sqlite:///internships.db

# --- Alerting ---------------------------------------------------------------
# Gmail App Password (NOT your normal password): myaccount.google.com/apppasswords
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
GMAIL_APP_PASSWORD=

# ntfy.sh topic. Pick something long and unguessable - the topic name is the
# only secret protecting your alerts. Subscribe to it in the ntfy mobile app.
NTFY_TOPIC=

# --- Free job APIs ----------------------------------------------------------
# Adzuna: https://developer.adzuna.com/ (free tier, no card)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJOBS: https://developer.usajobs.gov/apirequest/ (free, email signup)
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Contact address sent to SEC EDGAR in the User-Agent header (they ask for one).
SEC_CONTACT_EMAIL=

# --- Cross-company tracker sources ------------------------------------------
# Optional. Raises the GitHub API rate limit used to auto-discover new tracker
# repos (a classic personal access token with no scopes is enough).
GITHUB_TOKEN=

# Reddit script-app credentials (free): https://www.reddit.com/prefs/apps -> create
# app -> "script". Without these the Reddit megathread source skips itself.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional token for an ntfy account with a reserved/protected topic.
# A token alone does not make a public topic private. Set topic access controls
# on your server/account separately; do not purchase a plan for this project.
NTFY_TOKEN=
NTFY_BASE=https://ntfy.sh

# Private dashboard authentication. Set before exposing a live-data instance.
ADMIN_PASSWORD=

# Optional free Google Sheets bridge; keep token private in Render/Actions.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SYNC_TOKEN=
GOOGLE_SHEET_URL=

# Separate public, fictional expo demo. Uses demo.db even if DATABASE_URL is set.
DEMO_MODE=0
# Local ONNX embedding model, no inference API or paid credits.
AI_ENABLED=1
MODEL_CACHE=.model-cache
# Optional locally hosted, free language model. Blank uses source excerpts.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
